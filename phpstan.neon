includes:
    - vendor/phpstan/phpstan-symfony/extension.neon
    - vendor/phpstan/phpstan-symfony/rules.neon
parameters:
    level: 8
    paths:
        - src
    # The private MajesticDev\Discord plugin can't be installed in CI, so src/Discord is analysed
    # against stubs of the parts of it we use (scanFiles, since the classes do not exist to override).
    scanFiles:
        - tests/PhpstanStubs/MajesticDevDiscord.php
    # The exclusions below don't apply until you add code that triggers them.
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        # Private plugin CI can't install; only referenced by ::class.
        -
            message: '#Class MajesticDev\\Discord\\CommandNetDiscordPlugin not found#'
            path: src/CommandNetPlugin.php
        # Doctrine assigns entity properties, phpstan cannot see it happen.
        -
            messages:
                - '#Property .+ is never written, only read.#'
                - '#Property .+ is never assigned .+ so it can be removed from the property type.#'
            path: src/Entity/*
