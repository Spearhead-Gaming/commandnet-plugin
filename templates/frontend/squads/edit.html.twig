{% extends '@Forumify/frontend/base.html.twig' %}

{% block title_page %}{{ creating ? (unit is defined ? 'Add Squad' : 'Add Team') : 'Edit Squad/Team' }}{% endblock %}

{% block body %}
    <h1>
        {% if not creating %}Edit {{ squad.name }}
        {% elseif unit is defined %}Add squad under {{ unit.name }}
        {% else %}Add team under {{ squad.name }}
        {% endif %}
    </h1>

    <div class="card">
        <div class="card-body">
            {{ form_start(form) }}
            {{ form_widget(form) }}
            <div class="flex gap-2 mb-4" data-position-presets>
                <span class="text-small">Quick-fill positions:</span>
                <button type="button" class="btn-outlined btn-small" data-preset="Squad Leader&#10;Squad Medic">Squad</button>
                <button type="button" class="btn-outlined btn-small" data-preset="Team Lead&#10;Medic&#10;Team Member">Team</button>
            </div>
            <div class="flex justify-end gap-2 mt-4">
                <a class="btn-outlined" href="{{ unit is defined ? path('command_net_my_unit', { id: unit.id }) : path('command_net_my_squad', { id: squad.id }) }}">Cancel</a>
                <button class="btn-primary" type="submit">{{ creating ? (unit is defined ? 'Create Squad' : 'Create Team') : 'Save Changes' }}</button>
            </div>
            {{ form_end(form) }}
        </div>
    </div>
    <script>
        document.querySelector('[data-position-presets]')?.addEventListener('click', (event) => {
            const preset = event.target.dataset?.preset;
            if (!preset) return;
            const textarea = document.querySelector('textarea[name$="[positions]"]');
            if (!textarea) return;
            textarea.value = textarea.value.trim() ? textarea.value.trimEnd() + '\n' + preset : preset;
        });
    </script>
{% endblock %}
