{% extends '@Forumify/frontend/base.html.twig' %}

{% block title_page %}Attendance{% endblock %}

{% block body %}
    <h1 class="mb-4">Attendance</h1>

    {% if myStats %}
        <div class="card mb-4">
            <div class="card-title">My Attendance</div>
            <div class="card-body cnf-stat-row">
                <div>
                    <p class="text-small mb-0">Attended</p>
                    <p class="text-bold mb-0">{{ myStats.attended }}</p>
                </div>
                <div>
                    <p class="text-small mb-0">No-shows</p>
                    <p class="text-bold mb-0">{{ myStats.noShows }}</p>
                </div>
                <div>
                    <p class="text-small mb-0">No-show rate</p>
                    <p class="text-bold mb-0">{{ myStats.noShowRate is not null ? myStats.noShowRate ~ '%' : '—' }}</p>
                </div>
                <div>
                    <p class="text-small mb-0">Current streak</p>
                    <p class="text-bold mb-0">{{ myStats.currentStreak }}</p>
                </div>
                <div>
                    <p class="text-small mb-0">Last attended</p>
                    <p class="text-bold mb-0">{{ myStats.lastAttended ? myStats.lastAttended|format_date : '—' }}</p>
                </div>
            </div>
        </div>
    {% elseif not canViewAll %}
        <div class="card">
            <div class="card-body">
                <p class="text-small mb-0">No enlisted personnel file, and no attendance to show.</p>
            </div>
        </div>
    {% endif %}

    {% if canViewAll %}
        <div class="card">
            <div class="card-title">Roster</div>
            <div class="card-body">
                {% if roster is empty %}
                    <p class="text-small mb-0">No active personnel.</p>
                {% else %}
                    <table class="cnf-table">
                        <thead>
                            <tr>
                                <th data-sort="text">Soldier <i class="ph ph-caret-up-down"></i></th>
                                <th data-sort="num">Attended <i class="ph ph-caret-up-down"></i></th>
                                <th data-sort="num">No-shows <i class="ph ph-caret-up-down"></i></th>
                                <th data-sort="num">No-show rate <i class="ph ph-caret-up-down"></i></th>
                                <th data-sort="num">Streak <i class="ph ph-caret-up-down"></i></th>
                                <th data-sort="date">Last attended <i class="ph ph-caret-up-down"></i></th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for row in roster %}
                                <tr data-date="{{ row.stats.lastAttended ? row.stats.lastAttended|date('Y-m-d') : '' }}">
                                    <td>
                                        <a href="{{ path('command_net_roster_profile', { username: row.soldier.user.username }) }}">
                                            {% if row.soldier.rank %}{{ row.soldier.rank.abbreviation }}{% endif %}
                                            {{ row.soldier.user.displayName }}
                                        </a>
                                    </td>
                                    <td>{{ row.stats.attended }}</td>
                                    <td>{{ row.stats.noShows }}</td>
                                    <td>{{ row.stats.noShowRate is not null ? row.stats.noShowRate ~ '%' : '—' }}</td>
                                    <td>{{ row.stats.currentStreak }}</td>
                                    <td>{{ row.stats.lastAttended ? row.stats.lastAttended|format_date : '—' }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% endif %}
            </div>
        </div>
    {% endif %}

    <style>
        .cnf-stat-row { display: flex; flex-wrap: wrap; gap: 24px; }
        table.cnf-table { width: 100%; border-collapse: collapse; font-size: 14px; }
        table.cnf-table th { text-align: left; font-size: 11px; text-transform: uppercase; letter-spacing: .04em; opacity: .65; padding: 8px 4px; cursor: pointer; white-space: nowrap; user-select: none; }
        table.cnf-table th i { font-size: 12px; opacity: .6; }
        table.cnf-table td { padding: 10px 4px; border-top: 1px solid var(--border-color, #eee); vertical-align: top; }
    </style>
    <script>
        (function () {
            document.querySelectorAll('table.cnf-table thead th[data-sort]').forEach(function (th) {
                th.addEventListener('click', function () {
                    var table = th.closest('table');
                    var tbody = table.querySelector('tbody');
                    var index = Array.prototype.indexOf.call(th.parentNode.children, th);
                    var ascending = th.dataset.dir !== 'asc';
                    table.querySelectorAll('th[data-sort]').forEach(function (other) { delete other.dataset.dir; });
                    th.dataset.dir = ascending ? 'asc' : 'desc';

                    var rows = Array.prototype.slice.call(tbody.querySelectorAll('tr'));
                    rows.sort(function (a, b) {
                        var av, bv;
                        if (th.dataset.sort === 'date') {
                            av = a.dataset.date || '';
                            bv = b.dataset.date || '';
                        } else if (th.dataset.sort === 'num') {
                            av = parseFloat(a.children[index].textContent) || 0;
                            bv = parseFloat(b.children[index].textContent) || 0;
                            return ascending ? av - bv : bv - av;
                        } else {
                            av = a.children[index].textContent.trim().toLowerCase();
                            bv = b.children[index].textContent.trim().toLowerCase();
                        }
                        if (av < bv) return ascending ? -1 : 1;
                        if (av > bv) return ascending ? 1 : -1;
                        return 0;
                    });
                    rows.forEach(function (row) { tbody.appendChild(row); });
                });
            });
        })();
    </script>
{% endblock %}
