{% extends '@Forumify/frontend/base.html.twig' %}

{% block title_page %}
    {{ profile.rank ? profile.rank.abbreviation ~ ' ' : '' }}{{ profile.user.displayName }}
{% endblock %}

{% block body %}
    <div class="card mb-4">
        <div class="card-body grid-2">
            <div class="text-right border-r pr-3 mr-3">
                {% include '@Forumify/components/avatar.html.twig' with {
                    user: profile.user,
                    className: 'avatar-lg',
                } only %}
            </div>
            <div>
                <h2 class="mb-0">
                    {% if profile.rank %}{{ profile.rank.abbreviation }}{% endif %}
                    {{ profile.user.displayName }}
                    {% if profile.status.value != 'active' %}
                        <span class="tag {{ profile.status.value == 'awol' ? 'tag-error' : '' }} text-regular ml-2">
                            {{ profile.status.label }}
                        </span>
                    {% endif %}
                </h2>
                {% if profile.callsign %}
                    <p class="text-small mb-2">"{{ profile.callsign }}"</p>
                {% endif %}

                {% if primaryAssignment %}
                    <p class="mb-1">
                        <i class="ph ph-flag"></i>
                        {{ primaryAssignment.unit.name }}
                        {% if primaryAssignment.position %} &middot; {{ primaryAssignment.position.title }}{% endif %}
                    </p>
                {% endif %}
                {% if profile.serviceNumber %}
                    <p class="text-small mb-1">{{ 'command_net.personnel.service_number'|trans }}: {{ profile.serviceNumber }}</p>
                {% endif %}
                {% if profile.enlistmentDate %}
                    <p class="text-small mb-0">{{ 'command_net.personnel.enlisted'|trans }}: {{ profile.enlistmentDate|format_date }}</p>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="grid gap-4">
        <div class="col-xs-12 col-md-4 flex flex-col gap-4">
            <div class="card">
                <div class="card-title">{{ 'command_net.personnel.awards'|trans }}</div>
                {% if profile.awards is empty %}
                    <div class="card-body">
                        <p class="text-small">{{ 'command_net.personnel.no_awards'|trans }}</p>
                    </div>
                {% else %}
                    <div class="card-body grid-xs-6 grid-md-4 gap-4 items-center">
                        {% for soldierAward in profile.awards %}
                            <img
                                width="100%"
                                height="auto"
                                src="{% if soldierAward.award.icon %}{{ asset(soldierAward.award.icon, 'forumify.asset')|imagine_filter('avatar_lg') }}{% endif %}"
                                title="{{ soldierAward.award.name }} - {{ soldierAward.dateAwarded|format_date }}"
                            >
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
            <div class="card">
                <div class="card-title">{{ 'command_net.personnel.qualifications'|trans }}</div>
                {% if profile.qualifications is empty %}
                    <div class="card-body">
                        <p class="text-small">{{ 'command_net.personnel.no_qualifications'|trans }}</p>
                    </div>
                {% else %}
                    <div class="card-body grid-xs-6 grid-md-4 gap-4 items-center">
                        {% for soldierQualification in profile.qualifications %}
                            <img
                                width="100%"
                                height="auto"
                                src="{% if soldierQualification.qualification.icon %}{{ asset(soldierQualification.qualification.icon, 'forumify.asset')|imagine_filter('avatar_lg') }}{% endif %}"
                                title="{{ soldierQualification.qualification.name }} - {{ soldierQualification.dateEarned|format_date }}"
                            >
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
            {% if profile.bio %}
                <div class="card">
                    <div class="card-title">{{ 'command_net.personnel.bio'|trans }}</div>
                    <div class="card-body">
                        <p>{{ profile.bio }}</p>
                    </div>
                </div>
            {% endif %}
        </div>

        <div class="col-xs-12 col-md-8">
            <div class="card">
                <div class="card-title">{{ 'command_net.personnel.service_record'|trans }}</div>
                {% if profile.serviceRecords is empty %}
                    <div class="card-body">
                        <p class="text-small">{{ 'command_net.personnel.no_service_records'|trans }}</p>
                    </div>
                {% else %}
                    <ul class="card-body p-0">
                        {% for record in profile.serviceRecords %}
                            <li class="p-2 pr-4 pl-4 flex flex-col gap-1{% if not loop.last %} border-b{% endif %}">
                                <div class="flex items-center gap-2">
                                    <span class="tag">{{ record.type.label }}</span>
                                    <span class="text-bold">{{ record.title }}</span>
                                </div>
                                {% if record.description %}
                                    <p class="mb-0 text-small">{{ record.description }}</p>
                                {% endif %}
                                <div class="text-small">{{ record.date|format_date }}</div>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
