{% extends '@Forumify/frontend/base.html.twig' %}

{% block title_page %}{{ creating ? 'Add Child Unit' : 'Edit Unit' }} - {{ unit.name }}{% endblock %}

{% block body %}
    <h1>{{ creating ? 'Add child unit under ' ~ unit.name : 'Edit ' ~ unit.name }}</h1>

    <div class="card">
        <div class="card-body">
            {{ form_start(form) }}
            {{ form_widget(form) }}
            <div class="flex gap-2 mb-4" data-position-presets>
                <span class="text-small">Quick-fill positions:</span>
                {% for name, titles in presets %}
                    <button type="button" class="btn-outlined btn-small" data-preset="{{ titles|join('&#10;') }}">{{ name }}</button>
                {% endfor %}
            </div>
            <div class="flex justify-end gap-2 mt-4">
                <a class="btn-outlined" href="{{ path('command_net_my_unit', { id: unit.id }) }}">Cancel</a>
                <button class="btn-primary" type="submit">{{ creating ? 'Create Unit' : 'Save Changes' }}</button>
            </div>
            {{ form_end(form) }}
        </div>
    </div>
    <script>
        // Fills the "Positions in this unit" textarea with a standard billet list for the
        // common echelons (see the Team/Squad decision, 2026-09-27) instead of retyping the
        // same lines for every team/squad you create. Appends rather than overwrites, in case
        // the unit already has something typed - unwanted lines are just deleted by hand.
        document.querySelector('[data-position-presets]')?.addEventListener('click', (event) => {
            const preset = event.target.dataset?.preset;
            if (!preset) return;
            const textarea = document.querySelector('textarea[name$="[positions]"]');
            if (!textarea) return;
            textarea.value = textarea.value.trim() ? textarea.value.trimEnd() + '\n' + preset : preset;
        });
    </script>
{% endblock %}
