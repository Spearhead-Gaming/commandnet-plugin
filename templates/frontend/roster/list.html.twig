{% extends '@Forumify/frontend/base.html.twig' %}

{% block title_page %}{{ 'command_net.roster.title'|trans }}{% endblock %}

{% block body %}
    <div class="mb-4 flex items-center justify-between flex-wrap gap-2">
        <h1 class="mb-0">{{ 'command_net.roster.title'|trans }}</h1>
        <div class="flex items-center gap-3">
            <a class="btn-outlined btn-small" href="{{ path('command_net_units') }}">
                <i class="ph ph-sitemap"></i> Org Chart
            </a>
            {% if is_granted('command-net.attendance.view_own') or is_granted('command-net.attendance.view_all') %}
                <a class="btn-outlined btn-small" href="{{ path('command_net_attendance') }}">
                    <i class="ph ph-chart-bar"></i> Attendance
                </a>
            {% endif %}
            {% if is_granted('command-net.promotions.view') %}
                <a class="btn-outlined btn-small" href="{{ path('command_net_promotions') }}">
                    <i class="ph ph-medal"></i> Promotions
                </a>
            {% endif %}
            {% if is_granted('command-net.reportin.submit') %}
                <form method="post" action="{{ path('command_net_report_in') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('report_in') }}">
                    <button type="submit" class="btn-primary btn-small">
                        <i class="ph ph-map-pin-line"></i> Report In
                    </button>
                </form>
            {% endif %}
            <p class="text-small mb-0">
                {{ 'command_net.roster.count'|trans({ count: roster|length }) }}
            </p>
        </div>
    </div>

    {% if roster is empty %}
        <div class="card">
            <div class="card-body">
                <p class="text-small">{{ 'command_net.roster.empty'|trans }}</p>
            </div>
        </div>
    {% else %}
        <div class="grid-xs-12 grid-sm-6 grid-md-4 gap-4">
            {% for soldier in roster %}
                <a class="card" href="{{ path('command_net_roster_profile', { username: soldier.user.username }) }}">
                    <div class="card-body flex items-center gap-3">
                        {% include '@Forumify/components/avatar.html.twig' with {
                            user: soldier.user,
                            className: 'avatar-md',
                        } only %}
                        <div>
                            <p class="mb-0 text-bold">
                                {% if soldier.rank %}{{ soldier.rank.abbreviation }}{% endif %}
                                {{ soldier.user.displayName }}
                            </p>
                            {% if soldier.callsign %}
                                <p class="mb-0 text-small">"{{ soldier.callsign }}"</p>
                            {% endif %}
                            {% set assignment = soldier.primaryAssignment %}
                            {% if assignment %}
                                <p class="mb-0 text-small">
                                    {{ assignment.unit.name }}
                                    {%- if assignment.position %} &middot; {{ assignment.position.title }}{% endif %}
                                    {%- if soldier.specialty %} &middot; {{ soldier.specialty.abbreviation }}{% endif %}
                                </p>
                            {% endif %}
                            {% if is_granted('command-net.admin.reportin.view') %}
                                <p class="mb-0 text-small">
                                    {{ soldier.lastReportIn ? 'Reported in ' ~ soldier.lastReportIn|format_date(true) : 'Never reported in' }}
                                </p>
                            {% endif %}
                        </div>
                    </div>
                </a>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
