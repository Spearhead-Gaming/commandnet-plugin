{% extends '@Forumify/frontend/base.html.twig' %}

{% block title_page %}{{ definition.name }}{% endblock %}

{% block body %}
    <h1 class="mb-2">{{ definition.name }}</h1>
    {% if definition.description %}
        <p class="mb-4">{{ definition.description|nl2br }}</p>
    {% endif %}

    <div class="card">
        <div class="card-body">
            {{ form_start(form) }}
            {{ form_widget(form) }}
            <div class="flex justify-end gap-2 mt-4">
                <a class="btn-outlined" href="{{ path('command_net_forms') }}">{{ 'command_net.cancel'|trans }}</a>
                <button class="btn-primary" type="submit">Submit</button>
            </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
