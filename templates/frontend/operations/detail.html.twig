{% extends '@Forumify/frontend/base.html.twig' %}

{% block title_page %}{{ operation.title }}{% endblock %}

{% block body %}
    <div class="card mb-4">
        <div class="card-body">
            <div class="flex items-center gap-2 mb-2">
                <span class="tag">{{ operation.type.label }}</span>
                <span class="tag">{{ operation.status.label }}</span>
                {% if aarStatus.value in ['due', 'overdue', 'filed'] %}
                    <span class="tag {{ aarStatus.value == 'overdue' ? 'tag-error' : '' }}">{{ aarStatus.label }}</span>
                {% endif %}
            </div>
            <h1 class="mb-2">{{ operation.title }}</h1>
            <p class="text-small mb-1"><i class="ph ph-calendar"></i> {{ operation.startDateTime|format_date }}</p>
            {% if operation.location %}
                <p class="text-small mb-1"><i class="ph ph-map-pin"></i> {{ operation.location }}</p>
            {% endif %}
            {% if operation.unit %}
                <p class="text-small mb-1"><i class="ph ph-flag"></i> {{ operation.unit.name }}</p>
            {% endif %}
            {% if operation.leader %}
                <p class="text-small mb-1"><i class="ph ph-user"></i> Led by {{ operation.leader.displayName }}</p>
            {% endif %}
            {% if operation.deployment %}
                <p class="text-small mb-1"><i class="ph ph-stack"></i> {{ operation.deployment.name }}</p>
            {% endif %}
            {% if operation.maxParticipants %}
                <p class="text-small mb-1"><i class="ph ph-users"></i> Limited to {{ operation.maxParticipants }} joiners</p>
            {% endif %}
            {% if aarStatus.value in ['due', 'overdue'] %}
                <p class="text-small mb-1 {{ aarStatus.value == 'overdue' ? 'text-bold' : '' }}">
                    <i class="ph ph-warning"></i>
                    {{ aarStatus.value == 'overdue' ? 'The after-action report was due' : 'The after-action report is due by' }}
                    {{ aarDueAt|format_date(true) }}.
                </p>
            {% endif %}
            {% if canManagePatrol %}
                <div class="flex items-center gap-2 mt-2">
                    <a class="btn-outlined btn-small" href="{{ path('command_net_patrol_edit', { id: operation.id }) }}">Edit patrol</a>
                    {% if operation.status.value != 'cancelled' %}
                        <form method="post" action="{{ path('command_net_patrol_cancel', { id: operation.id }) }}" onsubmit="return confirm('Cancel this patrol?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('patrol_cancel_' ~ operation.id) }}">
                            <button type="submit" class="btn-outlined btn-small">Cancel patrol</button>
                        </form>
                    {% endif %}
                    {% if canDeletePatrol %}
                        <form method="post" action="{{ path('command_net_patrol_delete', { id: operation.id }) }}" onsubmit="return confirm('Permanently delete this patrol? This removes it, its sign-ups and its reports, and cannot be undone.');">
                            <input type="hidden" name="_token" value="{{ csrf_token('patrol_delete_' ~ operation.id) }}">
                            <button type="submit" class="btn-outlined btn-small">Delete patrol</button>
                        </form>
                    {% endif %}
                </div>
            {% endif %}
            {% if infoUrl or briefingUrl %}
                <div class="flex gap-2 mt-2">
                    {% if infoUrl %}
                        <a class="btn-outlined btn-small" href="{{ infoUrl }}">
                            <i class="ph ph-info"></i> Operation info
                        </a>
                    {% endif %}
                    {% if briefingUrl %}
                        <a class="btn-outlined btn-small" href="{{ briefingUrl }}">
                            <i class="ph ph-file-text"></i> View briefing
                        </a>
                    {% endif %}
                </div>
            {% endif %}
        </div>
    </div>

    <div class="grid gap-4">
        <div class="col-xs-12 col-md-8 flex flex-col gap-4">
            {% if operation.content %}
                <div class="card">
                    <div class="card-title">{{ 'command_net.operations.opord'|trans }}</div>
                    <div class="card-body">
                        {{ operation.content|rich }}
                    </div>
                </div>
            {% endif %}

            <div class="card">
                <div class="card-title flex items-center justify-between">
                    {{ 'command_net.operations.aars'|trans }}
                    {% if canFileAar %}
                        <a class="btn-outlined btn-small" href="{{ path('command_net_operation_aar', { id: operation.id }) }}">
                            {{ 'command_net.operations.submit_aar'|trans }}
                        </a>
                    {% endif %}
                </div>
                {% if operation.aars is empty %}
                    <div class="card-body">
                        <p class="text-small">{{ 'command_net.operations.no_aars'|trans }}</p>
                    </div>
                {% else %}
                    <div class="card-body flex flex-col gap-4">
                        {% for aar in operation.aars %}
                            <div{% if not loop.last %} class="pb-4 border-b"{% endif %}>
                                <div class="flex items-center gap-2 mb-2 text-small">
                                    <span class="text-bold">{{ aar.submittedBy.displayName }}</span>
                                    <span>{{ aar.createdAt|format_date }}</span>
                                    {% if aar.objectivesMet is not null %}
                                        <span class="tag {{ aar.objectivesMet ? '' : 'tag-error' }}">
                                            {{ aar.objectivesMet ? 'command_net.operations.objectives_met'|trans : 'command_net.operations.objectives_not_met'|trans }}
                                        </span>
                                    {% endif %}
                                    {% if aar.submittedBy == app.user or is_granted('command-net.admin.operations.manage') %}
                                        <form method="post" action="{{ path('command_net_operation_aar_delete', { id: operation.id, aarId: aar.id }) }}" onsubmit="return confirm('Remove this after-action report? This cannot be undone.');" class="ml-auto">
                                            <input type="hidden" name="_token" value="{{ csrf_token('operation_aar_delete_' ~ aar.id) }}">
                                            <button type="submit" class="btn-link btn-small" title="Remove report"><i class="ph ph-trash"></i></button>
                                        </form>
                                    {% endif %}
                                </div>
                                {{ aar.summary|rich }}
                                {% if aar.notes %}
                                    <p class="text-small mt-2">{{ aar.notes }}</p>
                                {% endif %}
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        </div>

        <div class="col-xs-12 col-md-4 flex flex-col gap-4">
            {% if myProfile and myProfile.enlisted and is_granted('command-net.operations.rsvp') %}
                <div class="card">
                    <div class="card-title">{{ 'command_net.operations.your_rsvp'|trans }}</div>
                    <div class="card-body flex flex-col gap-2">
                        {% for statusCase in rsvpStatuses %}
                            {% if statusCase.value != 'no_response' %}
                                <form method="post" action="{{ path('command_net_operation_rsvp', { id: operation.id }) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('operation_rsvp_' ~ operation.id) }}">
                                    <input type="hidden" name="status" value="{{ statusCase.value }}">
                                    <button
                                        type="submit"
                                        class="{{ myRsvp and myRsvp.status == statusCase ? 'btn-primary' : 'btn-outlined' }} w-full"
                                    >
                                        {{ statusCase.label }}
                                    </button>
                                </form>
                            {% endif %}
                        {% endfor %}
                        {% if myRsvp and myRsvp.status.value != 'no_response' %}
                            <form method="post" action="{{ path('command_net_operation_rsvp', { id: operation.id }) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('operation_rsvp_' ~ operation.id) }}">
                                <input type="hidden" name="status" value="no_response">
                                <button type="submit" class="btn-link btn-small w-full">Withdraw RSVP</button>
                            </form>
                        {% endif %}
                    </div>
                </div>
            {% endif %}

            <div class="card">
                <div class="card-title">{{ 'command_net.operations.roster'|trans }}</div>
                {% if attendanceRows is empty %}
                    <div class="card-body">
                        <p class="text-small">{{ 'command_net.operations.no_rsvps'|trans }}</p>
                    </div>
                {% else %}
                    <ul class="card-body p-0">
                        {% for row in attendanceRows %}
                            {% set rsvp = row.rsvp %}
                            <li class="p-2 pr-4 pl-4 flex items-center justify-between gap-2{% if not loop.last %} border-b{% endif %}">
                                <span>{{ row.soldier.user.displayName }}</span>
                                <div class="flex items-center gap-2">
                                    <span class="tag {{ rsvp is not null and rsvp.status.value == 'declined' ? 'tag-error' : '' }}">
                                        {{ rsvp is not null ? rsvp.status.label : 'No response' }}
                                    </span>
                                    {% if canMarkAttendance %}
                                        <form method="post" action="{{ path('command_net_operation_attendance', { id: operation.id }) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('operation_attendance_' ~ operation.id) }}">
                                            <input type="hidden" name="soldier_id" value="{{ row.soldier.id }}">
                                            <input type="hidden" name="attended" value="{{ rsvp is not null and rsvp.attended is same as(true) ? '' : '1' }}">
                                            <button
                                                type="submit"
                                                class="btn-small {{ rsvp is not null and rsvp.attended is same as(true) ? 'btn-primary' : 'btn-outlined' }}"
                                                title="{{ 'command_net.operations.mark_attended'|trans }}"
                                            >
                                                <i class="ph ph-check"></i>
                                            </button>
                                        </form>
                                        <form method="post" action="{{ path('command_net_operation_attendance', { id: operation.id }) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('operation_attendance_' ~ operation.id) }}">
                                            <input type="hidden" name="soldier_id" value="{{ row.soldier.id }}">
                                            <input type="hidden" name="attended" value="{{ rsvp is not null and rsvp.attended is same as(false) ? '' : '0' }}">
                                            <button
                                                type="submit"
                                                class="btn-small {{ rsvp is not null and rsvp.attended is same as(false) ? 'btn-primary' : 'btn-outlined' }}"
                                                title="{{ 'command_net.operations.mark_absent'|trans }}"
                                            >
                                                <i class="ph ph-x"></i>
                                            </button>
                                        </form>
                                    {% elseif rsvp.attended is not null %}
                                        <span class="tag {{ rsvp.attended ? '' : 'tag-error' }}">
                                            {{ rsvp.attended ? 'command_net.operations.attended'|trans : 'command_net.operations.absent'|trans }}
                                        </span>
                                    {% endif %}
                                </div>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
