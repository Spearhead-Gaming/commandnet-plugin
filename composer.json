{
    "name": "majesticdev/commandnet-plugin",
    "description": "Personnel & unit management system built for our community.",
    "type": "forumify-plugin",
    "license": "proprietary",
    "require": {
        "php": ">=8.4",
        "forumify/forumify-platform": "^1.3"
    },
    "require-dev": {
        "dama/doctrine-test-bundle": "^8.0",
        "dg/bypass-finals": "^1.9",
        "phpunit/phpunit": "^11.5",
        "symfony/browser-kit": "^7.4",
        "symfony/css-selector": "^7.4",
        "zenstruck/foundry": "^2.8",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-symfony": "^2.0",
        "slevomat/coding-standard": "^8.15",
        "squizlabs/php_codesniffer": "^3.13"
    },
    "autoload": {
        "psr-4": {
            "MajesticDev\\CommandNet\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MajesticDev\\CommandNet\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": false,
            "symfony/runtime": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "lock": false
    },
    "extra": {
        "forumify-plugin-class": "MajesticDev\\CommandNet\\CommandNetPlugin"
    }
}
